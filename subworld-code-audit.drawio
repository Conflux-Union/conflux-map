<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-12T06:00:00.000Z" agent="Codex code audit" version="24.7.17" type="device" compressed="false">
  <diagram id="overview" name="01-识别总流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="子世界识别总流程（只根据当前分支代码）" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="legend" value="蓝色＝输入/事件　绿色＝安全确认　黄色＝暂定/等待　红色＝失败或风险边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1040" y="24" width="500" height="36" as="geometry"/></mxCell>

        <mxCell id="start" value="Minecraft 客户端事件&lt;br&gt;&lt;b&gt;进服 / GameJoin / Respawn / 每 tick / 区块装卸 / 聊天命令&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="260" height="86" as="geometry"/></mxCell>
        <mxCell id="companion" value="服务器 Companion 已给出权威 worldId？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="105" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="companionYes" value="直接采用 Companion 身份&lt;br&gt;客户端子世界识别不参与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="78" width="245" height="72" as="geometry"/></mxCell>
        <mxCell id="canonical" value="规范化服务器地址&lt;br&gt;得到 serverId；默认端口旧 key 先做持久化合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="170" width="245" height="76" as="geometry"/></mxCell>
        <mxCell id="registry" value="读取子世界清单&lt;br&gt;&lt;b&gt;config/confluxmap/client_worlds.json&lt;/b&gt;&lt;br&gt;损坏则隔离并 fail-closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="255" height="82" as="geometry"/></mxCell>
        <mxCell id="evidence" value="收集当前观察&lt;br&gt;种子签名、品牌/命令树/生物群系、维度/出生点/边界、游戏模式、位置与轨迹、3×3 地形指纹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="295" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="exact" value="有没有更确定的答案？&lt;br&gt;1. Velocity /server 返回 backend 名称&lt;br&gt;2. 已绑定切换命令且切换被确认&lt;br&gt;3. 用户手动选择" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="exactYes" value="按精确目标选择 profile&lt;br&gt;先写 registry，成功后才发布内存状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="345" y="315" width="245" height="78" as="geometry"/></mxCell>
        <mxCell id="filter" value="按种子先过滤候选&lt;br&gt;再做硬冲突否决和加权评分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="480" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="newSeed" value="这是未出现过的新种子，且允许自动创建？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="245" height="96" as="geometry"/></mxCell>
        <mxCell id="autoCreate" value="异步创建新 profile&lt;br&gt;显示名 World N&lt;br&gt;存储：首个 world，后续 client-UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="468" width="230" height="102" as="geometry"/></mxCell>
        <mxCell id="scoreResult" value="评分结果" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="635" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="confirmed" value="正式确认&lt;br&gt;证据足、领先够、无硬冲突&lt;br&gt;&lt;b&gt;STABLE + RESOLVED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="650" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="provisional" value="暂定候选（provisional）&lt;br&gt;对外仍是 RESOLVED/STABLE&lt;br&gt;等待地形或稳定信号确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="625" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="manual" value="无法安全判断&lt;br&gt;&lt;b&gt;WAITING_FOR_USER&lt;/b&gt;&lt;br&gt;暂停地图会话，等待手选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="635" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="session" value="输出 WorldIdentity&lt;br&gt;&lt;b&gt;&lt;serverId&gt;/&lt;storageId&gt;&lt;/b&gt;&lt;br&gt;WorldSessionTracker 启动或轮换会话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="805" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="consumers" value="会话消费者同步切换&lt;br&gt;地图缓存、瓦片、路径点、标注、预测、导出等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="810" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="buffer" value="识别未定时：地图快照进入内存缓冲&lt;br&gt;上限 8192；确认后回放，否决时丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="805" width="330" height="78" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="companion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="是" edge="1" parent="1" source="companion" target="companionYes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="否" edge="1" parent="1" source="companion" target="canonical" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;fontColor=#1D4ED8;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="canonical" target="registry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="registry" target="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="evidence" target="exact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="有" edge="1" parent="1" source="exact" target="exactYes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="没有" edge="1" parent="1" source="exact" target="filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="filter" target="newSeed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="是" edge="1" parent="1" source="newSeed" target="autoCreate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="否，有候选" edge="1" parent="1" source="newSeed" target="scoreResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="正式" edge="1" parent="1" source="scoreResult" target="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="暂定" edge="1" parent="1" source="scoreResult" target="provisional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="不足/冲突" edge="1" parent="1" source="scoreResult" target="manual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="exactYes" target="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" edge="1" parent="1" source="autoCreate" target="session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="770"/><mxPoint x="460" y="770"/></Array></mxGeometry></mxCell>
        <mxCell id="e17" edge="1" parent="1" source="confirmed" target="session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="代码也输出身份" edge="1" parent="1" source="provisional" target="session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" edge="1" parent="1" source="session" target="consumers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" edge="1" parent="1" source="provisional" target="buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="src" value="主要代码入口：ClientPlayNetworkHandlerMixin、ClientChunkManagerMixin、WorldSessionTracker、ClientMultiworldService、ClientWorldProfileResolver" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="50" y="930" width="1450" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="switching" name="02-切换检测分支">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="s0"/>
        <mxCell id="s1" parent="s0"/>
        <mxCell id="stitle" value="什么时候认为“子世界切换了”？" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="s1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell>
        <mxCell id="sgame" value="收到 GameJoin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="60" y="105" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="sfirst" value="本连接第一次 GameJoin？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="340" y="92" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="sfirstyes" value="普通进服&lt;br&gt;重置观察，尝试 Velocity 精确查询，然后识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="650" y="75" width="270" height="78" as="geometry"/></mxCell>
        <mxCell id="sproxy" value="同连接再次 GameJoin＝代理边界&lt;br&gt;先抓离开轨迹/visit，再清空旧轨迹&lt;br&gt;记录 departedProfile，禁止立刻选回旧档案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="650" y="175" width="310" height="96" as="geometry"/></mxCell>
        <mxCell id="ssameseed" value="新旧种子相同，且同种子档案 ≤ 1？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="1040" y="175" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="ssameblock" value="不猜、不自动新建&lt;br&gt;标记 same-seed guard&lt;br&gt;转人工选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1360" y="180" width="190" height="86" as="geometry"/></mxCell>

        <mxCell id="srespawn" value="收到 Respawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="60" y="335" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="skeep" value="无命令锁 + 当前正式稳定 + 种子相同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="340" y="320" width="240" height="92" as="geometry"/></mxCell>
        <mxCell id="skeepyes" value="当成死亡/维度切换&lt;br&gt;继续沿用当前 profile&lt;br&gt;只清观察证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="665" y="315" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="skeepno" value="重新 PROBING&lt;br&gt;暂停正式地图写入，重新识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="665" y="430" width="250" height="76" as="geometry"/></mxCell>
        <mxCell id="srisk" value="高风险窗口&lt;br&gt;如果真实切换只发同种子 Respawn，代码会先继续写旧档案；只能等后续弱信号再纠正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1030" y="315" width="350" height="92" as="geometry"/></mxCell>

        <mxCell id="sweak" value="没有 GameJoin 的隐式切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="60" y="575" width="245" height="62" as="geometry"/></mxCell>
        <mxCell id="sworldref" value="ClientWorld 对象换了但维度没换&lt;br&gt;→ 直接开始探测&lt;br&gt;对象和维度一起换＝普通维度访问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="365" y="540" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="sweaksignals" value="20 tick 窗口内的弱信号&lt;br&gt;• 游戏模式变化&lt;br&gt;• 水平跳跃 &gt; 96 格&lt;br&gt;• 同坐标 unload+load ≥ 35%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="700" y="535" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="sweakdecide" value="两个不同弱信号？&lt;br&gt;或区块替换 ≥ 70%？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1045" y="545" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="sprobe" value="是：beginProbing&lt;br&gt;清 profile 锁，暂停会话，重新评分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1360" y="535" width="200" height="88" as="geometry"/></mxCell>
        <mxCell id="smiss" value="否：继续 STABLE&lt;br&gt;&lt;b&gt;远距离跳转若新旧区块坐标不重叠，只得到 1 个弱信号，可能永远漏检&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1025" y="680" width="350" height="92" as="geometry"/></mxCell>

        <mxCell id="scmd" value="用户提交已绑定命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="60" y="820" width="245" height="62" as="geometry"/></mxCell>
        <mxCell id="slock" value="锁定目标 profile；先保存离开轨迹&lt;br&gt;等待真实世界边界，期间不把旧块给目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="365" y="805" width="285" height="86" as="geometry"/></mxCell>
        <mxCell id="scmdconfirm" value="确认方式&lt;br&gt;• 新 GameJoin&lt;br&gt;• 弱切换 + 种子/身份变化" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="735" y="800" width="235" height="96" as="geometry"/></mxCell>
        <mxCell id="scmdok" value="确认且目标无已知冲突&lt;br&gt;正式选择目标 profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="s1"><mxGeometry x="1050" y="795" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="scmdtimeout" value="超时&lt;br&gt;无弱切换：恢复旧 profile&lt;br&gt;有弱切换：保持阻塞，等人工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="1050" y="900" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="smixin" value="版本风险：1.18.2 / 1.20.1 / 1.21.3 / 1.21.4 最终 mixin 清单未注册 ChatScreenMixin，命令锁入口失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1350" y="830" width="210" height="120" as="geometry"/></mxCell>

        <mxCell id="se1" edge="1" parent="s1" source="sgame" target="sfirst" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" value="是" edge="1" parent="s1" source="sfirst" target="sfirstyes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" value="否" edge="1" parent="s1" source="sfirst" target="sproxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" edge="1" parent="s1" source="sproxy" target="ssameseed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" value="是" edge="1" parent="s1" source="ssameseed" target="ssameblock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se6" edge="1" parent="s1" source="srespawn" target="skeep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se7" value="是" edge="1" parent="s1" source="skeep" target="skeepyes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se8" value="否" edge="1" parent="s1" source="skeep" target="skeepno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se9" edge="1" parent="s1" source="skeepyes" target="srisk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se10" edge="1" parent="s1" source="sweak" target="sworldref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se11" edge="1" parent="s1" source="sworldref" target="sweaksignals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se12" edge="1" parent="s1" source="sweaksignals" target="sweakdecide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se13" value="是" edge="1" parent="s1" source="sweakdecide" target="sprobe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se14" value="否" edge="1" parent="s1" source="sweakdecide" target="smiss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se15" edge="1" parent="s1" source="scmd" target="slock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se16" edge="1" parent="s1" source="slock" target="scmdconfirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se17" value="确认" edge="1" parent="s1" source="scmdconfirm" target="scmdok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se18" value="超时/冲突" edge="1" parent="s1" source="scmdconfirm" target="scmdtimeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se19" edge="1" parent="s1" source="slock" target="smixin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ssrc" value="关键代码：ClientMultiworldService 320-471、2009-2081、2201-2329、2531-2710；ClientWorldChangeDetector 11-52；各版本 confluxmap.mixins.json" style="text;html=1;fontSize=12;fontColor=#64748B;align=left;" vertex="1" parent="s1"><mxGeometry x="50" y="1010" width="1450" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="scoring" name="03-评分标准">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="q0"/>
        <mxCell id="q1" parent="q0"/>
        <mxCell id="qtitle" value="候选怎么打分？（大白话 + 精确阈值）" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="q1"><mxGeometry x="40" y="20" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="qfilter" value="第一步：只让种子兼容的 profile 参赛&lt;br&gt;没有种子时才让同服务器全部 profile 参赛" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=15;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="55" y="95" width="330" height="82" as="geometry"/></mxCell>
        <mxCell id="qveto" value="硬否决（任一命中就出局）&lt;br&gt;• 已知种子不符　• profile 身份信号冲突&lt;br&gt;• 稳定访问上下文冲突　• 地形分 &lt; 0.60&lt;br&gt;• 上次稳定指针冲突　• 刚离开的 profile&lt;br&gt;• 最新维度不符" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="450" y="80" width="380" height="125" as="geometry"/></mxCell>
        <mxCell id="qaux" value="辅助分：把“当前有数据”的项按权重归一化&lt;br&gt;&lt;b&gt;轨迹 0.60&lt;/b&gt;　上次稳定 0.20　游戏模式 0.15&lt;br&gt;访问上下文 0.25　身份信号 0.25&lt;br&gt;身份信号原分＝min(1, 匹配数 ÷ 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="895" y="80" width="380" height="125" as="geometry"/></mxCell>
        <mxCell id="qtotal" value="总分&lt;br&gt;有地形：&lt;b&gt;0.75 × 辅助分 + 0.25 × 地形分&lt;/b&gt;&lt;br&gt;无地形：总分＝辅助分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=15;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="1330" y="90" width="230" height="100" as="geometry"/></mxCell>

        <mxCell id="qterrain" value="地形指纹怎么比？&lt;br&gt;玩家周围完整 3×3 chunk；每 chunk 抽 4×4 列，共 144 列。每列：高度差≤1 加0.45，≤3 加0.25；生物群系同加0.30；地表类型同加0.15；液体深度同加0.10、差1加0.05。&lt;br&gt;&lt;b&gt;9 个 chunk 必须都可比；正式高匹配 ≥0.85；硬不匹配 &lt;0.60。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="55" y="270" width="550" height="145" as="geometry"/></mxCell>
        <mxCell id="qqueue" value="证据队列（越靠前，门槛越低）&lt;br&gt;&lt;b&gt;Q1&lt;/b&gt;：位置/轨迹在近距离带内 + 有对应中心地形&lt;br&gt;&lt;b&gt;Q2&lt;/b&gt;：位置/轨迹在近距离带内&lt;br&gt;&lt;b&gt;Q3&lt;/b&gt;：远离历史点，只靠其余证据&lt;br&gt;近距离带：主世界类 48 格；下界 6 格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="660" y="270" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="qthreshold" value="自动选择门槛&lt;br&gt;Q1 ≥ 60%　Q2 ≥ 70%　Q3 ≥ 80%&lt;br&gt;&lt;b&gt;服务器只有 1 个 profile 时，一律至少 95%&lt;/b&gt;&lt;br&gt;领先第二名：Q1/Q2 必须严格 &gt; 3 个百分点；Q3 必须严格 &gt; 15 点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="1125" y="270" width="425" height="145" as="geometry"/></mxCell>

        <mxCell id="qgate" value="最终还要同时满足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=16;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="55" y="485" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="qconditions" value="• 有连续性证据（轨迹/位置，或代理边界下已知该维度历史）&lt;br&gt;• 有地形，或至少 2 个独立辅助因素&lt;br&gt;• 没有 unresolved legacy 候选&lt;br&gt;• 没有更高优先队列的冲突候选&lt;br&gt;• 单 profile 且无地形时，位置不能太远" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="355" y="465" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="qdecision" value="所有门槛都过了？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=15;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="875" y="475" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="qmanual" value="否&lt;br&gt;AMBIGUOUS / WAITING_FOR_USER&lt;br&gt;展示每个候选的分数、阻塞原因和 veto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="1250" y="470" width="285" height="110" as="geometry"/></mxCell>

        <mxCell id="qconfirmtype" value="过门槛后：证据能不能“唯一证明”它？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="675" y="660" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="qterrainok" value="地形正式确认&lt;br&gt;最佳地形 ≥0.85；多候选时对每个兼容候选至少领先 0.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="230" y="670" width="330" height="88" as="geometry"/></mxCell>
        <mxCell id="qsignalok" value="单 profile 稳定信号确认&lt;br&gt;至少 2 个 profile 级身份信号匹配，且优于其他未冲突候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="q1"><mxGeometry x="230" y="795" width="330" height="88" as="geometry"/></mxCell>
        <mxCell id="qprovisional" value="不能唯一证明&lt;br&gt;先 provisional：地图快照缓冲，继续等地形或稳定信号&lt;br&gt;&lt;b&gt;注意：代码仍把它暴露为 RESOLVED/STABLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="1080" y="675" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="qprovrisk" value="没有“地形重试耗尽后自动转人工”的终止分支：证据不再变化时，provisional 可以长期存在。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="1080" y="825" width="360" height="78" as="geometry"/></mxCell>

        <mxCell id="qe1" edge="1" parent="q1" source="qfilter" target="qveto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe2" edge="1" parent="q1" source="qveto" target="qaux" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe3" edge="1" parent="q1" source="qaux" target="qtotal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe4" edge="1" parent="q1" source="qtotal" target="qqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe5" edge="1" parent="q1" source="qterrain" target="qqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#059669;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe6" edge="1" parent="q1" source="qqueue" target="qthreshold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe7" edge="1" parent="q1" source="qthreshold" target="qconditions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe8" edge="1" parent="q1" source="qconditions" target="qdecision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe9" value="否" edge="1" parent="q1" source="qdecision" target="qmanual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe10" value="是" edge="1" parent="q1" source="qdecision" target="qconfirmtype" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe11" value="地形唯一" edge="1" parent="q1" source="qconfirmtype" target="qterrainok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe12" value="单档案稳定信号" edge="1" parent="q1" source="qconfirmtype" target="qsignalok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe13" value="都不能" edge="1" parent="q1" source="qconfirmtype" target="qprovisional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe14" edge="1" parent="q1" source="qprovisional" target="qprovrisk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qsrc" value="关键代码：ClientWorldProfileResolver 16-39、1202-1652、1850-2039；ClientWorldTerrainFingerprint 17-19、120-139、298-321" style="text;html=1;fontSize=12;fontColor=#64748B;align=left;" vertex="1" parent="q1"><mxGeometry x="50" y="940" width="1450" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="persistence" name="04-创建命名与档案读写">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>
        <mxCell id="ptitle" value="自动创建、命名、档案写入，以及列表地图从哪里读" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="p1"><mxGeometry x="40" y="20" width="1200" height="44" as="geometry"/></mxCell>
        <mxCell id="pcreateHead" value="A. 自动创建与命名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=18;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="50" y="85" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="pcond" value="同时满足才自动建&lt;br&gt;1. 有种子　2. 没有同种子 profile&lt;br&gt;3. 没有任何 recognitionDisabled 档案&lt;br&gt;4. 数量未到上限（默认/最大 128）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="50" y="160" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="pname" value="显示名&lt;br&gt;普通自动创建：&lt;b&gt;World {当前数量+1}&lt;/b&gt;&lt;br&gt;Velocity 精确识别：规范化 backend 名称&lt;br&gt;手动创建：用户输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="430" y="155" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="pstorage" value="磁盘命名和显示名分开&lt;br&gt;第一个普通 profile：&lt;b&gt;world&lt;/b&gt;&lt;br&gt;后续：&lt;b&gt;client-&lt;UUID&gt;&lt;/b&gt;&lt;br&gt;因此显示名重名不会覆盖目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="780" y="155" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="pdup" value="低风险：显示名不校验唯一&lt;br&gt;删除后按 size+1 命名，或手工重命名，都可能出现两个 World 2；磁盘安全，但列表难辨认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="1130" y="155" width="385" height="120" as="geometry"/></mxCell>

        <mxCell id="pregHead" value="B. 子世界清单 / visit / 轨迹怎么写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=18;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="50" y="330" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="pregpath" value="子世界清单&lt;br&gt;&lt;b&gt;&lt;configDir&gt;/confluxmap/client_worlds.json&lt;/b&gt;&lt;br&gt;上限 4 MiB；启动时读取/normalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="50" y="410" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="pregcopy" value="每次管理修改/确认&lt;br&gt;先复制一份 registry，在副本里改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="420" y="415" width="245" height="82" as="geometry"/></mxCell>
        <mxCell id="pregsave" value="写 .tmp → 原子 move 覆盖正式 JSON&lt;br&gt;写成功才 publish 到内存&lt;br&gt;写失败：内存不变并返回错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="725" y="405" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="pregbad" value="读取损坏/过大/schema 不支持&lt;br&gt;写 client_worlds.json.blocked&lt;br&gt;原文件移到 .bad.&lt;时间&gt;&lt;br&gt;识别 fail-closed，用户显式修复后重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="1085" y="400" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="pvisit" value="稳定 visit&lt;br&gt;默认每 3 秒，或移动 ≥256 格，或维度/模式/信号/地形变化时刷新&lt;br&gt;客户端线程 prepare → 单 IO 线程写 JSON → 后续 tick publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="50" y="545" width="405" height="105" as="geometry"/></mxCell>
        <mxCell id="ptraj" value="轨迹 checkpoint（独立文件）&lt;br&gt;&lt;b&gt;&lt;gameDir&gt;/confluxmap/trajectory-checkpoints/&lt;serverHash&gt;[.candidate.&lt;profileHash&gt;].json&lt;/b&gt;&lt;br&gt;约每 100 tick，切换/退出时强制尝试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="515" y="545" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="pshutdown" value="退出缺口&lt;br&gt;若 visit/checkpoint 已在写，最新一笔只留在内存队列；退出后没有下一 tick 去继续入队。所有后台任务又共用总计 5 秒关闭期限。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1045" y="540" width="430" height="115" as="geometry"/></mxCell>

        <mxCell id="pmapHead" value="C. 地图本体与列表右侧预览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=18;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="50" y="710" width="360" height="54" as="geometry"/></mxCell>
        <mxCell id="pcapture" value="主线程把已加载 chunk 采样为 ChunkSnapshot&lt;br&gt;写入当前 MapWorld（REAL_LIVE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="50" y="790" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="pload" value="同一 region 第一次触碰时&lt;br&gt;IO 线程先读旧 .cfr，合并为 REAL_CACHED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="405" y="790" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="pflush" value="地图落盘&lt;br&gt;正常每 30 秒 sweep；切维度/子世界/断线时 final flush&lt;br&gt;.tmp + force(true) + 原子 move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="760" y="780" width="305" height="100" as="geometry"/></mxCell>
        <mxCell id="ppath" value="地图文件路径&lt;br&gt;&lt;b&gt;&lt;gameDir&gt;/confluxmap/cache/&lt;storageServerId&gt;/&lt;storageId&gt;/&lt;dimension&gt;/&lt;layer&gt;/r.&lt;rx&gt;.&lt;rz&gt;.cfr&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="1120" y="775" width="410" height="110" as="geometry"/></mxCell>
        <mxCell id="ppreview" value="列表选择 profile → 取 lastVisitedAt 最新的维度 → worker 直接扫上面的 .cfr 画缩略图&lt;br&gt;&lt;b&gt;不是 Minecraft 存档，不是 client_worlds.json，也不是当前内存 MapWorld。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="300" y="940" width="570" height="100" as="geometry"/></mxCell>
        <mxCell id="players" value="预览层固定映射&lt;br&gt;下界：nether_roof（不是地下 nether 层）&lt;br&gt;末地：end　其他维度：surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="925" y="940" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="pstale" value="因此当前 profile 最近约 30 秒、尚未 flush 的地图不会出现在预览；刚创建档案可能暂时显示空。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="1270" y="940" width="285" height="92" as="geometry"/></mxCell>

        <mxCell id="pe1" edge="1" parent="p1" source="pcond" target="pname" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" edge="1" parent="p1" source="pname" target="pstorage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" edge="1" parent="p1" source="pstorage" target="pdup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" edge="1" parent="p1" source="pregpath" target="pregcopy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" edge="1" parent="p1" source="pregcopy" target="pregsave" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" value="加载失败" edge="1" parent="p1" source="pregpath" target="pregbad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="525"/><mxPoint x="1235" y="525"/></Array></mxGeometry></mxCell>
        <mxCell id="pe7" edge="1" parent="p1" source="pcapture" target="pload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe8" edge="1" parent="p1" source="pload" target="pflush" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe9" edge="1" parent="p1" source="pflush" target="ppath" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16A34A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe10" value="直接读取" edge="1" parent="p1" source="ppath" target="ppreview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="915"/><mxPoint x="585" y="915"/></Array></mxGeometry></mxCell>
        <mxCell id="pe11" edge="1" parent="p1" source="ppreview" target="players" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#D97706;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe12" edge="1" parent="p1" source="players" target="pstale" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="psrc" value="关键代码：ClientWorldProfileResolver 132-245、787-813、2125-2153；ClientWorldProfileIo；ClientMultiworldService 1255-1628；RegionDiskCache；ClientWorldMapPreview；RegionHistoryPreviewLoader" style="text;html=1;fontSize=12;fontColor=#64748B;align=left;" vertex="1" parent="p1"><mxGeometry x="50" y="1060" width="1500" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="risks" name="05-破洞与数据风险">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="rtitle" value="“奇怪破洞”从哪里来？——已确认的代码风险链" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="r1"><mxGeometry x="40" y="20" width="1200" height="44" as="geometry"/></mxCell>
        <mxCell id="rlegend" value="严重度：红色 High（可能污染/丢持久数据）　橙色 Medium（局部缺块、假破洞或旧图）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="890" y="24" width="650" height="36" as="geometry"/></mxCell>

        <mxCell id="rh1" value="HIGH 1｜provisional 被否决仍写错档案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="50" y="95" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="rh1a" value="评分先暂定 A&lt;br&gt;代码把 A 暴露为 RESOLVED/STABLE，正式会话已启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="50" y="170" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="rh1b" value="新世界块既进 pending buffer，&lt;br&gt;又以 REAL_LIVE 放进 A 的 MapWorld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="355" y="170" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="rh1c" value="后续地形/信号硬冲突&lt;br&gt;只丢 pending buffer，并结束 A 会话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="670" y="170" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="rh1d" value="session-end flush 无 provisional gate&lt;br&gt;A 的 MapWorld 被永久写入 A/.cfr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="985" y="170" width="285" height="80" as="geometry"/></mxCell>
        <mxCell id="rh1e" value="结果：新世界方块混进旧档案&lt;br&gt;后续以 REAL_CACHED 读取，表现为突兀方块、裂缝或破洞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1315" y="160" width="245" height="100" as="geometry"/></mxCell>

        <mxCell id="rh2" value="HIGH 2｜读取队列满时，用“半张 region”覆盖完整历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="50" y="310" width="520" height="52" as="geometry"/></mxCell>
        <mxCell id="rh2a" value="已有 64 个 region 在排队读取&lt;br&gt;第 65 个 ensureRegionLoaded 返回 null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="50" y="385" width="280" height="78" as="geometry"/></mxCell>
        <mxCell id="rh2b" value="实时新块已先写入新的内存 Region&lt;br&gt;调用方忽略加载拒绝，也没有保证重试后再 flush" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="385" y="375" width="325" height="98" as="geometry"/></mxCell>
        <mxCell id="rh2c" value="此时立刻切换/断线&lt;br&gt;final flush 把仅有新块的 Region 写回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="765" y="385" width="285" height="78" as="geometry"/></mxCell>
        <mxCell id="rh2d" value="原子覆盖旧 .cfr&lt;br&gt;旧文件其他 255 个 chunk 中未加载部分变 UNKNOWN&lt;br&gt;&lt;b&gt;这是永久真实破洞&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1105" y="375" width="390" height="98" as="geometry"/></mxCell>

        <mxCell id="rh3" value="HIGH 3｜切换漏检，两个世界直接混档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="50" y="525" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="rh3a" value="同维度 + 同模式 + 无 GameJoin&lt;br&gt;服务器把玩家远距离传到另一个子世界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="50" y="600" width="290" height="78" as="geometry"/></mxCell>
        <mxCell id="rh3b" value="位置跳跃只有 1 个弱信号&lt;br&gt;新旧区块坐标不重叠，unload/load 交集为 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="395" y="590" width="320" height="98" as="geometry"/></mxCell>
        <mxCell id="rh3c" value="达不到“2 个弱信号或 70% 同坐标替换”&lt;br&gt;状态继续 STABLE，旧 WorldIdentity 不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="770" y="590" width="340" height="98" as="geometry"/></mxCell>
        <mxCell id="rh3d" value="结果：后续新世界块合法进入旧档案&lt;br&gt;不是空洞，而是更危险的跨世界拼接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1165" y="600" width="330" height="78" as="geometry"/></mxCell>

        <mxCell id="rm1" value="MEDIUM｜列表预览的“假破洞”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="50" y="750" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="rm1a" value="档案 &gt; 2048 个 .cfr 时只解码抽样区域&lt;br&gt;边界和探索数却按全部文件计算；UI 不显示 sampled&lt;br&gt;→ 未选区域透明，看起来像随机破洞（只影响缩略图）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="50" y="820" width="450" height="105" as="geometry"/></mxCell>
        <mxCell id="rm2" value="MEDIUM｜等待太久导致旧路段缺块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="560" y="750" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="rm2a" value="PROBING/WAITING 可无限持续；缓冲最多 8192 个 chunk/layer 键，满后删最旧。最终手选只回放剩余缓冲并重采当前视距，走远的早期路段不会补回。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="560" y="820" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="rm3" value="MEDIUM｜旧图或预测被挖空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1050" y="750" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="rm3a" value="• 预览只读落盘 .cfr：最近约 30 秒内容未显示&lt;br&gt;• 旧缓存若 chunkSource=PREDICTED，加载时被提升为 REAL_CACHED，真实层会遮掉预测层&lt;br&gt;后者是 master 已有风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="1050" y="820" width="450" height="105" as="geometry"/></mxCell>

        <mxCell id="rshutdown" value="另外两个数据丢失面：①退出时 in-flight visit/checkpoint 的最新一笔可能只留内存；②所有 worker+IO 共用总计 5 秒 shutdown，队列过长时 final flush 可能没跑完。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="260" y="970" width="1080" height="68" as="geometry"/></mxCell>

        <mxCell id="re1" edge="1" parent="r1" source="rh1a" target="rh1b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" edge="1" parent="r1" source="rh1b" target="rh1c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re3" edge="1" parent="r1" source="rh1c" target="rh1d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re4" edge="1" parent="r1" source="rh1d" target="rh1e" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B91C1C;strokeWidth=3;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re5" edge="1" parent="r1" source="rh2a" target="rh2b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re6" edge="1" parent="r1" source="rh2b" target="rh2c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re7" edge="1" parent="r1" source="rh2c" target="rh2d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B91C1C;strokeWidth=3;"><mxGeometry relative="1" as="geometry"/></mxCell>
