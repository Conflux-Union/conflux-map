        <mxCell id="2xsS6wr6TEIm8Q69_kY7-220" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="每个 profile 仅保留唯一最新维度与 X/Y/Z 终点；旧维度坐标不参与识别。因果走廊：中心线按前进距离 s 使用 0–1024 公式衰减；X/Z 横向偏差与 Y 高度差合成空间偏离 r，再乘以中心线与新鲜度；静止时退化为入口点到唯一最后点的三维距离" vertex="1">
          <mxGeometry height="110" width="270" x="-730" y="1675" as="geometry" />
        </mxCell>
        <mxCell id="2xsS6wr6TEIm8Q69_kY7-231" edge="1" parent="1" source="2xsS6wr6TEIm8Q69_kY7-225" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="2xsS6wr6TEIm8Q69_kY7-227" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2xsS6wr6TEIm8Q69_kY7-225" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="最高分门槛：队列1 &gt;=60%、队列2 &gt;=70%、队列3 &gt;=80%；队列1/2 无论地形是否可用均严格领先 &gt;3 个百分点，队列3 &gt;15；至少2个独立因素且轨迹连续；同 seed 稳定确认还需地形 &gt;=85% 并领先 &gt;=10；高优先级冲突阻断，缺地形最多 provisional" vertex="1">
          <mxGeometry height="60" width="120" x="684" y="680" as="geometry" />
        </mxCell>
        <mxCell id="2xsS6wr6TEIm8Q69_kY7-227" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="恢复地图；provisional 在当前 observation generation 内锁定候选，新数据立即显示于仅内存临时图层并同时入缓冲；确认后提交，真实边界/硬冲突则丢弃并人工选择" vertex="1">
          <mxGeometry height="60" width="120" x="684" y="800" as="geometry" />
        </mxCell>
        <mxCell id="2xsS6wr6TEIm8Q69_kY7-232" edge="1" parent="1" source="2xsS6wr6TEIm8Q69_kY7-229" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="2xsS6wr6TEIm8Q69_kY7-225" value="">
