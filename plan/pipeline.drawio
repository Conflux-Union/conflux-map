        <!-- PLAN-26-8-8-1007 runtime evidence subflows -->
        <mxCell id="codex-trajectory-sample" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="每客户端 tick：记录位置、水平速度、yaw/pitch、时间、维度、sequence；不等待服务器回包" vertex="1">
          <mxGeometry height="80" width="220" x="-1040" y="2300" as="geometry" />
        </mxCell>
        <mxCell id="codex-server-ack" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="服务端位置纠正：仅确认纠正发生时的精确位置并截断旧预测段；不是客户端移动 ACK，不用其年龄扩张当前候选走廊" vertex="1">
          <mxGeometry height="80" width="220" x="-780" y="2190" as="geometry" />
        </mxCell>
        <mxCell id="codex-trajectory-checkpoint" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="周期性原子轨迹 checkpoint；provisional 时携带候选 profileId/观察代次但不写稳定档案；新维度正式 visit 尚未落档时可作为该候选的临时维度证据；GameJoin HEAD 保存离开状态，TAIL 建立到达代次；确认合并、冲突删除" vertex="1">
          <mxGeometry height="80" width="220" x="-780" y="2410" as="geometry" />
        </mxCell>
        <mxCell id="codex-current-prediction" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="当前预测轨迹：最新本地速度 + 朝向 + 近期位移拟合；急转时采用最新方向；前向段限时" vertex="1">
          <mxGeometry height="80" width="240" x="-500" y="2190" as="geometry" />
        </mxCell>
        <mxCell id="codex-history-restore" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="历史轨迹：恢复最后点及其前一小段，用于拟合离开速度/朝向；连接代次分段，不跨代次连线；更早路径点不参与位置匹配" vertex="1">
          <mxGeometry height="80" width="240" x="-500" y="2410" as="geometry" />
        </mxCell>
        <mxCell id="codex-history-compare" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="比较当前观察代次入口点与候选最后点/从最后点开始的前向预测段；禁止整段历史路径 nearestApproach；proxy GameJoin 保留外层 serverId 但开启新轨迹代次；传送、维度切换或异常跳变截断" vertex="1">
          <mxGeometry height="80" width="240" x="-200" y="2300" as="geometry" />
        </mxCell>
        <mxCell id="codex-provisional-commit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="provisional 准入锁：普通移动/临时排名变化不得轮换 profile；快照在当前 MapWorld 内存可见但不落盘；同 profile 确认才提交，真实边界、明确冲突或人工切换才丢弃" vertex="1">
          <mxGeometry height="80" width="220" x="100" y="2300" as="geometry" />
        </mxCell>
