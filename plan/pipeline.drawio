          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- P0 same-seed integrity, default-port identity and explainability subflows -->
        <mxCell id="codex-default-port-identity" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="服务器入口规范化：host 与 host:25565 为同一逻辑服务器；非默认端口、DNS/IPv4/方括号 IPv6 保持安全隔离" vertex="1">
          <mxGeometry height="90" width="260" x="-1040" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="codex-default-port-merge" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="加载旧键并执行非破坏别名合并：profile 均保留，旧地图目录原地归属；重复 ID 改为可审计别名并报告冲突，保存失败不得新建空命名空间" vertex="1">
          <mxGeometry height="100" width="280" x="-720" y="3295" as="geometry" />
        </mxCell>
        <mxCell id="codex-same-seed-membership" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="同 seed 是多档案成员关系：所有兼容档案评分；真实 proxy GameJoin 只硬排除 HEAD 阶段已经确认的离开 profile，provisional 假设不得排他；候选最新维度不同时位置连续性不可用，不得读取该维度旧坐标；禁用旧 lastStable 加分；准入后锁定 observation generation" vertex="1">
          <mxGeometry height="100" width="280" x="-380" y="3295" as="geometry" />
        </mxCell>
        <mxCell id="codex-decision-diagnostics" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="每个终止分支都生成候选诊断：是否评分、seed/队列、因素原始值/权重/贡献、真实距离、本地证据年龄、位置纠正年龄、门槛/第二名/实际与所需领先差距、硬否决与最终结论" vertex="1">
          <mxGeometry height="120" width="300" x="-20" y="3285" as="geometry" />
        </mxCell>
        <mxCell id="codex-diagnostic-ui" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="子世界列表显示分数/未评分和关键结论；领先不足直接显示实际 X% 与要求 &amp;gt;Y%；详情完整显示因素与阻断原因并可滚动；当前档案注明确认来源" vertex="1">
